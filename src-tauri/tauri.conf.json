{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "typer",
  "version": "0.1.0",
  "identifier": "com.typer.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "typer",
        "width": 1280,
        "height": 800,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/opencode", "binaries/typer-mcp"],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJGNDJCMzE5MENFM0I3OTUKUldTVnQrTU1HYk5DTDBaUzU3K3NQMTJIOWFKSHFKZDJSQ3lQMTVPaVF3M3pqclVhT00wUHVRS3kK",
      "endpoints": [
        "https://github.com/Fooyer/Typer-app/releases/latest/download/latest.json"
      ]
    }
  }
}
